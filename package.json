{
  "name": "flybaterias-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site oficial da FlyBaterias \u2014 baterias automotivas em Salvador e regi\u00e3o.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "render:assets": "node scripts/render-assets.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test:e2e",
    "deploy": "npm run build && npm run build:worker && wrangler deploy",
    "preview:cf": "npm run build && npm run build:worker && wrangler dev",
    "build:worker": "node scripts/build-worker.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "serve": "^14.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.168.0"
  }
}
